# Plantilla de variables de entorno. Copia este archivo como `.env.local`
# y completa los valores reales (NO subas `.env.local` al repo).

# === MySQL (Hostinger) ===
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# === Supabase (almacenamiento de imágenes) ===
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=articulos

# === Panel /admin ===
ADMIN_USER=admin
ADMIN_PASSWORD=
# Cadena larga aleatoria. Genérala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# === Google Sheets (leads del formulario) ===
# URL /exec del Apps Script desplegado como Web App (ver scripts/google-sheets-leads.gs)
SHEETS_WEBHOOK_URL=

# === Correo (formulario del hero -> /api/contacto) ===
# Buzón SMTP de Hostinger con el que se envían las solicitudes.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@vanguardiamax.com
SMTP_PASS=
# Remitente visible (por defecto SMTP_USER)
CONTACT_FROM=
# Destinatarios de las solicitudes, separados por coma
CONTACT_TO=info@vanguardiamax.com, ayllondark@gmail.com
# Pruebas locales sin SMTP: 1 = no envía, imprime el correo en la consola
MAIL_DRY_RUN=
